{
  "version": 1,
  "settings": {
    "workgroup": "HOMELAB",
    "server_string": "Proxmox NAS GUI",
    "netbios_name": "TANK",
    "min_protocol": "SMB3"
  },
  "users": {
    "alice": {
      "description": "media user"
    },
    "bob": {
      "description": ""
    }
  },
  "groups": {
    "family": {
      "description": "household accounts"
    }
  },
  "shares": {
    "media": {
      "name": "media",
      "path": "/mnt/pool/media",
      "comment": "Films and series",
      "export": "hidden",
      "security": "private",
      "recycle": true,
      "user_access": {
        "alice": "write",
        "bob": "read"
      },
      "group_access": {
        "family": "read"
      }
    },
    "public": {
      "name": "public",
      "path": "/srv/public",
      "comment": "",
      "export": "yes",
      "security": "public",
      "recycle": false,
      "user_access": {},
      "group_access": {}
    }
  },
  "pools": {
    "media": {
      "name": "media",
      "mountpoint": "/mnt/pool/media",
      "branches": [
        {
          "path": "/mnt/disks/d1",
          "mode": "RW"
        },
        {
          "path": "/mnt/disks/d2",
          "mode": "RO"
        },
        {
          "path": "/mnt/disks/d3",
          "mode": "NC"
        }
      ],
      "create_policy": "epmfs",
      "minfreespace": "20G",
      "moveonenospc": false,
      "extra_options": "cache.files=partial,dropcacheonclose=true"
    }
  },
  "disk_mounts": {
    "d1": {
      "uuid": "1234abcd-56ef-78ab-90cd-1234567890ab",
      "fstype": "ext4",
      "mountpoint": "/mnt/disks/d1"
    },
    "d2": {
      "uuid": "abcd1234-ef56-ab78-cd90-ab0987654321",
      "fstype": "xfs",
      "mountpoint": "/mnt/disks/d2"
    }
  },
  "bind_mounts": {
    "kz-fontos": {
      "name": "kz-fontos",
      "source": "/mnt/fontos/kz",
      "target": "/mnt/family_pool/kz/fontos",
      "read_only": false
    },
    "kz-nemfontos": {
      "name": "kz-nemfontos",
      "source": "/mnt/pool/media/kz",
      "target": "/mnt/family_pool/kz/nemfontos",
      "read_only": true
    }
  },
  "disk_sleep": {
    "ata-TOSHIBA_DT01ACA300_334401VAS": {
      "idle_seconds": 1800,
      "method": "hdparm"
    },
    "ata-WDC_WD10SPCX-21KHST0_WD-WX21A44D9471": {
      "idle_seconds": 0,
      "method": null
    }
  },
  "disk_sleep_settings": {
    "enabled": true,
    "poll_seconds": 30,
    "default_idle_seconds": 0,
    "retention_days": 90,
    "temp_enabled": true,
    "temp_interval_seconds": 300,
    "temp_retention_days": 365,
    "temp_warn_celsius": 45,
    "temp_crit_celsius": 55
  }
}
