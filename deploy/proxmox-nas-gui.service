[Unit]
Description=Proxmox NAS GUI (Samba shares and mergerfs pools)
After=network.target smbd.service
Wants=smbd.service

[Service]
Type=exec
User=root
WorkingDirectory=/opt/proxmox-nas-gui/backend
ExecStart=/opt/proxmox-nas-gui/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8481 \
    --ssl-certfile /etc/proxmox-nas-gui/cert.pem \
    --ssl-keyfile /etc/proxmox-nas-gui/key.pem
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
